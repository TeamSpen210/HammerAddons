@SolidClass base(Trigger, RenderFields, Reflection) 
	appliesto(P1, P2) = trigger_portal_cleanser: "An Aperture Science Material Emancipation Grid, dissolves any entities that touch it and fizzles active portals when the player touches it."
	[
	spawnflags(flags)  =
		[
		1: "Clients/Players" : 1
		2: "NPCs" : 0
		8: "Physics Objects" : 1
		16: "Only player ally NPCs" : 0
		32: "Only clients in vehicles" : 0
		64: "Everything (not including physics debris)" : 0
		512: "Only clients *not* in vehicles" : 0
		1024: "Physics debris" : 0
		2048: "Only NPCs in vehicles (respects player ally flag)" : 0
		]
		
	visible[P2](boolean) : "Visible" : 1 : "If the fizzler is visible. This controls whether sounds will play."
	usescanline[P2](boolean) : "Use Scanline" : 1 : "If the field uses a scanline particle effect."
	
	scanlinecolor[P2CE](color255) : "Scanline Color" : "106 178 198 15" : "The color to use for the scanline particle effect."
	blockportalshots[P2CE](boolean) : "Block Portal Shots" : 1 : "Whether the fizzler will block portal shots."
	obstructportals[P2CE](boolean) : "Obstruct Portals" : 1 : "Whether the fizzler will act like a portal bumper, and fizzle portals when enabled."
	loopsound[P2CE](sound) : "Looping Sound" : "VFX.FizzlerLp" : "Sound played continuously while the fizzler is active."
	startsound[P2CE](sound) : "Start Sound" : "VFX.FizzlerStart" : "Sound played when the fizzler turns on."
	stopsound[P2CE](sound) : "Stop Sound" : "VFX.FizzlerStop" : "Sound played when the fizzler turns off."

	// Inputs
	input FizzleTouchingPortals[P2](void) : "Cause any portals in our volume to immediately fizzle."
	input SetBlockPortalShots[P2CE](bool) : "Set whether the fizzler will block portal shots."
	input SetObstructPortals[P2CE](bool) : "Set whether the fizzler will act like a portal bumper, and fizzle portals when enabled."
	input SetScanlineColor[P2CE](color255) : "Set the color to use for the scanline particle effect."


	// Outputs
	output OnDissolve(void) : "Fired whenever an entity is dissolved."
	output OnFizzle(void) : "Fired whenever an portals are fizzled."
	output OnDissolveBox(void) : "This cleanser dissolved an entity with a targetname of 'box.'"
	output OnPrimaryHit[Strata](void) : "Fired whenever the primary portal hits the cleanser."
	output OnSecondaryHit[Strata](void) : "Fired whenever the secondary portal hits the cleanser."
 	
	@resources
		[
	    sound "VFX.FizzlerLp"       [P2]
	    sound "VFX.FizzlerDestroy"  [P2]
	    sound "VFX.FizzlerStart"    [P2]
	    sound "VFX.FizzlerVortexLp" [P2]
	    sound "Prop.Fizzled"        [P2]
		particle cleanser_scanline  [P2]
		]
	]
